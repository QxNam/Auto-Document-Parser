MODE=dev

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET_NAME=pbl-bulk
S3_BUCKET_NAME_OUTPUT=pbl-output

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=adp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SECRET_API_KEY=abc

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_NAME=upload
KAFKA_CONSUMER_GROUP_ID=adp-consumer-group

REDIS_URL=redis://redis:6379/0
OBSERVER_TARGETS=local,s3,cache
LOCAL_SAVED_DIR=/tmp/saved
API_TIMEOUT_INTERVAL=60
MAX_FILE_SIZE_MB=10
MAX_PAGE_COUNT=200
ALLOWED_FILE_EXTENSIONS=.pdf,.docx,.txt,.jpg,.png,.jpeg,.xlsx,.xls

TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
ARTIFACTS_PATH=./weights/models_docling
OCR_ENGINE=auto
PAGE_BREAK_STR="\n--- Page break ---\n"

GEMINI_API_KEY=AIxxx

# Configs for tesseract
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=3
MKL_NUM_THREADS=3
VECLIB_MAXIMUM_THREADS=3
NUMEXPR_NUM_THREADS=3
OMP_THREAD_LIMIT=1
PYTORCH_NUM_THREADS=3
TESSERACT_LOG_LEVEL="ERROR"